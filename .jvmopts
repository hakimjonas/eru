# JVM Options for Eru Development
# These settings optimize for development and testing performance

# Heap Settings
-Xms2G
-Xmx8G

# Use G1 Garbage Collector (recommended for modern JVMs)
-XX:+UseG1GC

# G1 Tuning
-XX:G1HeapRegionSize=32m
-XX:MaxGCPauseMillis=200

# Reduce GC overhead for development
-XX:NewRatio=1

# Enable string deduplication for memory efficiency
-XX:+UseStringDeduplication

# JIT Compiler optimizations  
-XX:ReservedCodeCacheSize=256m
-XX:InitialCodeCacheSize=64m

# File encoding
-Dfile.encoding=UTF-8

# SBT specific
-Dsbt.coursier.home=.coursier
-Dsbt.ivy.home=.ivy2

# Enable compressed OOPs for memory efficiency
-XX:+UseCompressedOops