            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>sbt-site</name>
    <organization>
        <name>sbt</name>
        <url>https://www.scala-sbt.org/</url>
    </organization>
    <scm>
        <url>https://github.com/sbt/sbt-site</url>
        <connection>scm:git:git@github.com:sbt/sbt-site.git</connection>
    </scm>
    <developers>
        <developer>
            <id>contributors</id>
