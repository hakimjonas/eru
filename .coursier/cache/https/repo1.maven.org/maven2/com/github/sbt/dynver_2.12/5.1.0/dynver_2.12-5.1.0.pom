<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.sbt</groupId>
    <artifactId>dynver_2.12</artifactId>
    <packaging>jar</packaging>
    <description>An sbt plugin to dynamically set your version from git</description>
    <url>https://github.com/sbt/sbt-dynver</url>
    <version>5.1.0</version>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>dynver</name>
    <inceptionYear>2016</inceptionYear>
    <organization>
        <name>com.github.sbt</name>
        <url>https://github.com/sbt/sbt-dynver</url>
    </organization>
    <scm>
        <url>https://github.com/sbt/sbt-dynver</url>
        <connection>scm:git:git@github.com:sbt/sbt-dynver.git</connection>
    </scm>
    <developers>
        <developer>
            <id>dwijnand</id>
            <name>Dale Wijnand</name>
            <url>https://dwijnand.com</url>
            <email>dale wijnand gmail com</email>
        </developer>
    </developers>
    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>2.12.20</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>5.13.3.202401111512-r</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.scalacheck</groupId>
            <artifactId>scalacheck_2.12</artifactId>
            <version>1.18.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>