<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.portable-scala</groupId>
    <artifactId>sbt-platform-deps_2.12_1.0</artifactId>
    <packaging>jar</packaging>
    <description>sbt-platform-deps</description>
    <url>https://github.com/portable-scala/sbt-platform-deps</url>
    <version>1.0.2</version>
    <licenses>
        <license>
            <name>BSD 3-Clause</name>
            <url>https://github.com/portable-scala/sbt-platform-deps/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>sbt-platform-deps</name>
    <organization>
        <name>org.portable-scala</name>
        <url>https://github.com/portable-scala/sbt-platform-deps</url>
    </organization>
    <scm>
        <url>https://github.com/portable-scala/sbt-platform-deps</url>
        <connection>scm:git:git@github.com:portable-scala/sbt-platform-deps.git</connection>
        <developerConnection>scm:git:git@github.com:portable-scala/sbt-platform-deps.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <id>sjrd</id>
            <name>Sébastien Doeraene</name>
            <url>https://github.com/sjrd/</url>
        </developer>
        <developer>
            <id>densh</id>
            <name>Denys Shabalin</name>
            <url>https://github.com/densh/</url>
        </developer>
    </developers>
    <properties>
        <scalaVersion>2.12</scalaVersion>
        <sbtVersion>1.0</sbtVersion>
        <info.versionScheme>semver-spec</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>2.12.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.scala-sbt</groupId>
            <artifactId>sbt</artifactId>
            <version>1.0.2</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>