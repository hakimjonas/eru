<?xml version='1.0' encoding='UTF-8'?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.scala-native</groupId>
    <artifactId>sbt-scala-native_2.12_1.0</artifactId>
    <packaging>jar</packaging>
    <description>sbt-scala-native</description>
    <url>http://www.scala-native.org</url>
    <version>0.5.8</version>
    <licenses>
        <license>
            <name>BSD-like</name>
            <url>http://www.scala-lang.org/downloads/license.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <name>sbt-scala-native</name>
    <inceptionYear>2015</inceptionYear>
    <organization>
        <name>org.scala-native</name>
        <url>http://www.scala-native.org</url>
    </organization>
    <scm>
        <url>https://github.com/scala-native/scala-native</url>
        <connection>scm:git:git@github.com:scala-native/scala-native.git</connection>
    </scm>
    <developers>
        <developer>
            <id>densh</id>
            <name>Denys Shabalin</name>
            <url>http://den.sh</url>
            <email>denys.shabalin@epfl.ch</email>
        </developer>
        <developer>
            <id>wojciechmazur</id>
            <name>Wojciech Mazur</name>
            <url>https://github.com/WojciechMazur</url>
            <email>wmazur@virtuslab.com</email>
        </developer>
    </developers>
    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/scala-native/scala-native/issues</url>
    </issueManagement>
    <properties>
        <scalaVersion>2.12</scalaVersion>
        <sbtVersion>1.0</sbtVersion>
        <extraDependencyAttributes xml:space="preserve">+e:sbtVersion:#@#:+1.0:#@#:+module:#@#:+sbt-platform-deps_2.12_1.0:#@#:+e:scalaVersion:#@#:+2.12:#@#:+organisation:#@#:+org.portable-scala:#@#:+branch:#@#:+@#:NULL:#@:#@#:+revision:#@#:+1.0.1:#@#:</extraDependencyAttributes>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.scala-lang</groupId>
            <artifactId>scala-library</artifactId>
            <version>2.12.20</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.scala-sbt</groupId>
            <artifactId>sbt</artifactId>
            <version>1.10.11</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.scala-native</groupId>
            <artifactId>tools_2.12</artifactId>
            <version>0.5.8</version>
        </dependency>
        <dependency>
            <groupId>org.scala-native</groupId>
            <artifactId>test-runner_2.12</artifactId>
            <version>0.5.8</version>
        </dependency>
        <dependency>
            <groupId>org.portable-scala</groupId>
            <artifactId>sbt-platform-deps_2.12_1.0</artifactId>
            <version>1.0.1</version>
        </dependency>
    </dependencies>
</project>